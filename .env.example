# Copia este archivo a ".env" (en la raíz del proyecto) y completa los valores reales.
# ".env" está en .gitignore — nunca lo subas al repo.
# Lo usa docker-compose.yml para pasar credenciales a los contenedores.

# Backend
SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria
POSTGRES_PASSWORD=cambia_esta_password
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu_service_role_key

# Frontend (se pasan como build args a la imagen)
VITE_SUPABASE_ANON_KEY=tu_anon_key
VITE_GOOGLE_MAPS_API_KEY=tu_google_maps_api_key
